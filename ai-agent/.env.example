# 复制为 .env 后按需修改（勿提交真实密钥到 Git）
# 本地 Ollama（默认即可跑通）
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5vl:3b
# 健康建议等纯文本调用请用非 VL 模型，避免长 prompt 下 GGML_ASSERT
# LLM_MODEL_TEXT=deepseek-r1:1.5b
# 多模态推理耗时可设大些（秒）
# LLM_HTTP_TIMEOUT_SECONDS=600
# 向 Ollama 透传 num_gpu（默认 false；若你确认本机 Ollama 支持再设 true）
# LLM_OLLAMA_RUNTIME_OPTIONS=false
# LLM_OLLAMA_NUM_GPU=99
# 多图入模时缩小长边，减轻 Ollama 崩溃(500/502)；可改为 896 / 768
# LLM_IMAGE_MAX_LONG_EDGE=1280

HEALTH_API_BASE_URL=http://localhost:8080
